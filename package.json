{
  "name": "nexus-engine",
  "version": "1.0.0",
  "description": "Motor de juegos universal con IA integrada - Nexus Engine",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [
    "game-engine",
    "javascript",
    "ai",
    "graphics",
    "nexus"
  ],
  "author": "Pedro Abelardo Álvarez Ospina (Maxius) - Nexus",
  "license": "PROPRIETARY",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxiusofmaximus/nexus-engine.git"
  },
  "homepage": "https://github.com/maxiusofmaximus/nexus-engine",
  "build": {
    "appId": "com.nexus.engine",
    "productName": "Nexus Engine",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "index.html",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "uninstallDisplayName": "Nexus Engine",
      "artifactName": "Nexus-Engine-${version}-x64-setup.${ext}"
    }
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
